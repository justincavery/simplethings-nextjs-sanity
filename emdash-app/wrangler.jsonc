{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "simplethings",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-09-28",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFHCtnZ9ms2nBaDf",
		"TURNSTILE_HOSTNAMES": "simplethin.gs,www.simplethin.gs",
	},
	"triggers": {
		"crons": ["* * * * *"],
	},
	"routes": [
		{ "pattern": "simplethin.gs/*", "zone_name": "simplethin.gs" },
		{ "pattern": "www.simplethin.gs/*", "zone_name": "simplethin.gs" },
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "simplethings-cms-prod",
			"database_id": "21dfde7c-935c-4adf-9fd8-cb9fcbbbef2c",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "simplethings-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "be72fec1a7da4c9c8874aeb54577c39a",
		},
		{
			"binding": "SESSION",
			"id": "5600bbd856844a2ea46b37a7ff0bd66f",
		},
	],
	"ai_search_namespaces": [
		{
			"binding": "AI_SEARCH",
			"namespace": "default",
		},
	],
}
