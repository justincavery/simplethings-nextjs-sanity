{
  "name": "emdash-app",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Simple Things",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:worker": "wrangler dev --config dist/server/wrangler.json --local --port 8787",
    "review:worker": "astro build && wrangler dev --config dist/server/wrangler.json --local --port 8787",
    "deploy": "astro build && wrangler deploy",
    "cms:homepage-sections": "node scripts/update-homepage-sections-schema.mjs",
    "cms:consultancy-positioning": "node scripts/update-consultancy-positioning.mjs",
    "cms:html-in-canvas-post": "node scripts/update-html-in-canvas-post.mjs",
    "cms:publish-aeo-audit": "node scripts/publish-aeo-audit.mjs",
    "cms:brand-settings": "node scripts/update-brand-settings.mjs",
    "cms:configure-emdash-1": "node scripts/configure-emdash-1.mjs",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/cloudflare": "^1.0.1",
    "astro": "^7.3.5",
    "emdash": "^1.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@cloudflare/workers-types": "^5.20260928.1",
    "wrangler": "^4.142.0"
  }
}
